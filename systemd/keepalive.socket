[Unit]
Description=Keep Alive Manager control FIFO

[Socket]
# ListenFIFO gives the Bash daemon a local, user-private activation endpoint.
# The FIFO carries only tiny request IDs; message/config payloads use private runtime files.
ListenFIFO=%t/keepalive/control.fifo
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
Service=keepalive.service

[Install]
WantedBy=sockets.target
