[Unit]
Description=Keep Alive Manager per-user daemon
Documentation=file:%h/.local/share/keepalive-manager/README.md
# Keep the daemon and its FIFO endpoint in one lifecycle. The socket remains the
# activation entrypoint: a daemon failure must not tear it down, while stopping
# the socket must stop the daemon before RemoveOnStop unlinks the FIFO.
BindsTo=keepalive.socket
PartOf=keepalive.socket
After=keepalive.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/keepalive --service
Restart=on-failure
RestartSec=2s
# The daemon maps INT/TERM/HUP to 130/143/129 so the shell reports which signal ended
# it. Without this, systemd logs every deliberate stop as "Failed with result exit-code".
SuccessExitStatus=129 130 143
UMask=0077

# A keep-alive tolerates seconds of latency, so the daemon yields to interactive work.
# Every directive here is process-level (setpriority, sched_setscheduler, ioprio_set,
# prctl): none needs root or cgroup controller delegation, all predate the systemd 235
# floor, and helpers the daemon starts (dbus-send, qdbus, orca-ide, jq) inherit them.
# SCHED_BATCH rather than SCHED_IDLE: idle could starve a due send indefinitely under a
# saturated CPU, while batch only gives up wakeup preemption. The 50 ms timer slack lets
# the kernel coalesce the daemon's second-granularity wakeups with other timers.
Nice=10
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
TimerSlackNSec=50ms

# Stop (and therefore every update's restart) signals only the daemon. It finishes any
# delivery in flight - including the helper process sending it - flushes countdowns, and
# exits between loop iterations; the rest of the cgroup is killed after it exits, or with
# the final SIGKILL if it ever overstays the stop timeout.
KillMode=mixed

# Hardening here is deliberately limited to directives that do NOT place the
# daemon in a private mount namespace.
#
# Discovery resolves /proc/PID/cwd (session display name/directory) and
# /proc/PID/exe (classifier signature) for AI processes the daemon does not own.
# Those are magic symlinks: the kernel resolves them against the *reader's* mount
# namespace, so any namespace-creating option makes them fail with ENOENT while
# comm/cmdline/stat keep working. The visible result is every session rendering
# as name "unknown" / directory "?" with the exe component silently dropped from
# classification.
#
# Do not add PrivateTmp, PrivateDevices, ProtectSystem, ProtectHome, ProtectProc,
# ProtectKernelTunables, ProtectKernelModules, or ProtectKernelLogs here. Each one
# reintroduces that bug. The options below are seccomp/prctl based and safe.
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

# This service is intentionally user-scoped. Do not install it in /etc/systemd/system.
